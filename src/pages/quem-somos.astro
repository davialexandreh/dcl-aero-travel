---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PaginaTopo from '../components/PaginaTopo.astro';
import PainelLista from '../components/PainelLista.astro';
import Chegadas from '../components/Chegadas.astro';
import ChamadaFinal from '../components/ChamadaFinal.astro';
import { Image } from 'astro:assets';
import { site } from '../config/site';
import fotoChile from '../assets/fotos/chile.jpg';
import fotoRio from '../assets/fotos/rio-de-janeiro.jpg';
import fotoOrlando from '../assets/fotos/orlando.jpg';
import fotoBalneario from '../assets/fotos/balneario-camboriu.jpg';

const depoimentos = await getCollection('depoimentos');
// Fotos do David (CEO) em viagem, mandadas pelo cliente em 24/11/2026 e recortadas em 3:4.
// O destino vira a legenda, como num painel. A dos Andes fica na home (Jornada).
const fotos = [
  { src: fotoChile, destino: 'Chile', alt: 'David segurando o mastro de uma bandeira do Chile, num calçadão à beira-mar' },
  { src: fotoRio, destino: 'Rio de Janeiro', alt: 'David de braços cruzados na beira da baía, com o Pão de Açúcar ao fundo' },
  { src: fotoOrlando, destino: 'Orlando', alt: 'David em pé diante do castelo do Magic Kingdom' },
  { src: fotoBalneario, destino: 'Balneário Camboriú', alt: 'David caminhando num mirante, com os prédios e a praia ao fundo' },
];
const ficha = [
  { rotulo: 'Empresa', texto: site.nome },
  { rotulo: 'CEO', texto: site.responsavel },
  { rotulo: 'CNPJ', texto: site.cnpj },
  { rotulo: 'Cadastur', texto: site.cadastur ? `${site.cadastur}, no Ministério do Turismo` : 'a confirmar' },
  { rotulo: 'Atendimento', texto: `WhatsApp ${site.whatsappExibicao} e ${site.email}` },
];
---
<Base
  titulo="Quem somos | DCL Aero Travel"
  descricao="Conheça a DCL Aero Travel, que tem David Campos Luiz como CEO: passagens aéreas, pacotes e carros com acompanhamento do começo ao fim."
>
  <PaginaTopo
    titulo="Quem cota é quem cuida da sua viagem"
    lede="A DCL Aero Travel tem David Campos Luiz como CEO. Nossa equipe atende, emite, faz o check-in e acompanha cada viagem até a volta."
    mensagem="Olá! Vim pelo site da DCL e quero conversar sobre uma viagem."
    ref="quem-somos"
    rotuloBotao="Cotar no WhatsApp"
  />

  <section class="bg-marinho" aria-labelledby="ficha-titulo">
    <div class="mx-auto grid max-w-[78rem] gap-12 px-4 pb-20 sm:px-6 md:pb-28 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16 lg:px-8">
      <div>
        <h2 id="ficha-titulo" class="text-[2rem] sm:text-[2.75rem]">Uma agência de verdade, com nome e registro</h2>
        <p class="mt-6 max-w-[46ch] text-lg text-tinta-suave">
          A DCL atende pessoas e empresas com passagens aéreas, pacotes, aluguel de carros, personalização de roteiros, seguro viagem e cruzeiros. Do outro lado do WhatsApp está sempre a mesma equipe, que conhece a sua viagem.
        </p>
        <ul class="mt-10 grid max-w-[26rem] grid-cols-2 gap-3" role="list" aria-label="Fotos das viagens">
          {fotos.map((f) => (
            <li>
              <figure>
                <Image
                  src={f.src}
                  alt={f.alt}
                  widths={[320, 640]}
                  sizes="(min-width: 640px) 13rem, calc(50vw - 1.5rem)"
                  class="aspect-[3/4] w-full rounded-md object-cover"
                />
                <figcaption class="mt-2 font-painel text-xs font-semibold tracking-[0.12em] uppercase text-tinta-suave">{f.destino}</figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
      <PainelLista linhas={ficha} colunaRotulo="Ficha" colunaTexto="Dados" class="self-start" />
    </div>
  </section>

  <Chegadas depoimentos={depoimentos} continua />

  <ChamadaFinal
    titulo="Para onde vai a sua próxima viagem?"
    texto="Mande o destino e as datas. Nossa equipe responde e acompanha tudo, do orçamento à volta."
    mensagem="Olá! Vim pelo site da DCL e quero uma cotação."
    ref="quem-somos-final"
    rotuloBotao="Cotar no WhatsApp"
  />
</Base>
