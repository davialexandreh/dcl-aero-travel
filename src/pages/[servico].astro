---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PaginaTopo from '../components/PaginaTopo.astro';
import ServicoCorpo from '../components/ServicoCorpo.astro';
import Partidas from '../components/Partidas.astro';
import Balcao from '../components/Balcao.astro';
import ChamadaFinal from '../components/ChamadaFinal.astro';
import { servicos, type Servico } from '../data/servicos';

export function getStaticPaths() {
  return servicos.map((s) => ({ params: { servico: s.slug }, props: { s } }));
}

const { s } = Astro.props as { s: Servico };
const pacotes = s.mostraPacotes ? await getCollection('pacotes') : [];
const duvidas = (await getCollection('duvidas'))
  .filter((d) => d.data.servicos.includes(s.slug))
  .sort((a, b) => a.data.ordem - b.data.ordem);
---
<Base titulo={s.tituloSeo} descricao={s.descricaoSeo}>
  <PaginaTopo titulo={s.titulo} lede={s.lede} mensagem={s.mensagem} ref={s.ref} rotuloBotao={s.rotuloBotao} />
  <ServicoCorpo etapas={s.etapas} inclui={s.inclui} modalidades={s.modalidades} />

  {s.mostraPacotes && (
    <section class="bg-marinho" aria-label="Pacotes disponíveis">
      <div class="mx-auto max-w-[78rem] px-4 pb-20 sm:px-6 md:pb-28 lg:px-8">
        <Partidas
          partidas={pacotes}
          titulo="Pacotes"
          vazioPlacas="Em breve"
          vazio="Os pacotes prontos aparecem aqui. Enquanto isso, conte para a DCL o destino e as datas, e nossa equipe monta um pacote para você."
        />
      </div>
    </section>
  )}

  {duvidas.length > 0 && (
    <section class="bg-marinho" aria-label="Dúvidas frequentes">
      <div class="mx-auto max-w-[78rem] px-4 pb-20 sm:px-6 md:pb-28 lg:px-8">
        <Balcao duvidas={duvidas} ref={`${s.ref}-duvida`} />
      </div>
    </section>
  )}

  <ChamadaFinal
    titulo="Conte para onde você quer ir"
    texto="Mande o destino e as datas pelo WhatsApp. Nossa equipe responde e acompanha a sua viagem até a volta."
    mensagem={s.mensagem}
    ref={`${s.ref}-final`}
    rotuloBotao={s.rotuloBotao ?? 'Cotar no WhatsApp'}
  />
</Base>
