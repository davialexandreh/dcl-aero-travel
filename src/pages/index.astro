---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Partidas from '../components/Partidas.astro';
import Jornada from '../components/Jornada.astro';
import Portoes from '../components/Portoes.astro';
import Chegadas from '../components/Chegadas.astro';
import Empresas from '../components/Empresas.astro';

const promocoes = await getCollection('promocoes');
const depoimentos = await getCollection('depoimentos');
---
<Base
  titulo="DCL Aero Travel | Passagens com milhas, pacotes e carros"
  descricao="Passagens com milhas, pacotes e aluguel de carros com acompanhamento do começo ao fim: a DCL cuida da sua viagem até o check-in. Cote pelo WhatsApp."
>
  <section id="partidas" class="bg-marinho" aria-labelledby="inicio-titulo">
    <div class="mx-auto max-w-[78rem] px-4 pt-3 pb-16 sm:px-6 md:pt-10 md:pb-24 lg:px-8">
      <div class="grid gap-3 pb-5 md:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] md:items-end md:gap-12 md:pb-10">
        <h1 id="inicio-titulo" class="text-[2.125rem] sm:text-[3.5rem] lg:text-[4.25rem]">
          A gente cuida da sua viagem até o check-in
        </h1>
        <p class="max-w-[42ch] text-[1rem] text-tinta-suave md:text-lg">
          <!-- No celular, versão curta: o painel sobe e aparece mais uma partida na primeira tela. -->
          <span class="md:hidden">Passagens com milhas, pacotes e carros, direto pelo WhatsApp.</span>
          <span class="hidden md:inline">Passagens com milhas, pacotes e carros. A DCL cuida de tudo pelo WhatsApp, do orçamento à volta.</span>
        </p>
      </div>
      <Partidas partidas={promocoes} />
    </div>
  </section>
  <Jornada />
  <Portoes />
  <Chegadas depoimentos={depoimentos} />
  <Empresas />
</Base>
