---
// Texto em placas split-flap. O texto real fica acessível; as placas são só visuais.
interface Props {
  texto: string;
  minimo?: number;
  class?: string;
}
const { texto, minimo = 0, class: classe = '' } = Astro.props;
const proprias = Array.from(texto.toUpperCase());
const sobra = Math.max(0, minimo - proprias.length);
---
<span class={`placas ${classe}`} data-placas={texto.toUpperCase()}>
  <span class="sr-only">{texto}</span>
  {proprias.map((l) => (
    <span class="placa" aria-hidden="true" data-vazia={l === ' ' ? '' : undefined}>{l === ' ' ? '·' : l}</span>
  ))}
  {Array.from({ length: sobra }, () => (
    <span class="placa placa-sobra" aria-hidden="true" data-vazia="">·</span>
  ))}
</span>
