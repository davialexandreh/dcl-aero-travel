---
import Placas from './Placas.astro';

interface Depoimento {
  id: string;
  data: { nome: string; destino?: string; texto: string; ordem: number };
}
interface Props {
  depoimentos: Depoimento[];
  /* true quando a seção anterior também é marinho e já deixa o espaço embaixo (Quem somos). */
  continua?: boolean;
}
const { continua = false } = Astro.props;
const lista = [...Astro.props.depoimentos].sort((a, b) => a.data.ordem - b.data.ordem);
const largura = Math.max(8, ...lista.map((d) => d.data.destino?.length ?? 0));
---
<section class="bg-marinho" aria-labelledby="chegadas-titulo">
  <div class:list={['mx-auto max-w-[78rem] px-4 pb-20 sm:px-6 md:pb-28 lg:px-8', !continua && 'pt-20 md:pt-28']}>
    <div class="rounded-md bg-profundo shadow-[0_18px_40px_rgb(0_0_0/0.35)]">
      <header class="flex flex-wrap items-end justify-between gap-4 border-b border-linha px-4 pt-4 pb-3 sm:px-6">
        <h2 id="chegadas-titulo" class="font-painel text-[1.75rem] font-semibold tracking-[0.08em] uppercase sm:text-[2rem]">Chegadas</h2>
        <p class="pb-1 text-[0.9375rem] text-tinta-suave">Quem já voltou conta como foi.</p>
      </header>
      <div class="hidden grid-cols-[minmax(0,4fr)_minmax(0,3fr)_minmax(0,3fr)] gap-6 px-6 pt-3 pb-2 text-tinta-fraca md:grid" aria-hidden="true">
        <span class="rotulo-painel">Destino</span>
        <span class="rotulo-painel">Passageiro</span>
        <span class="rotulo-painel">Status</span>
      </div>
      <ul class="divide-y divide-linha" role="list">
        {lista.map((d) => (
          <li class="px-4 py-6 sm:px-6 md:py-8" data-acende="pouso">
            <div class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-4 gap-y-2 md:grid-cols-[minmax(0,4fr)_minmax(0,3fr)_minmax(0,3fr)] md:gap-x-6">
              <span class="col-span-2 md:col-span-1">
                <Placas texto={d.data.destino ?? '—'} minimo={largura} class="text-[1.0625rem] sm:text-[1.2rem] lg:text-[1.35rem]" />
              </span>
              <span class="font-painel text-lg font-medium tracking-[0.04em]">{d.data.nome}</span>
              <span class="justify-self-end md:justify-self-start" data-pouso><Placas texto="Desembarcou" minimo={11} class="text-[0.875rem] sm:text-[0.9375rem]" /></span>
            </div>
            <!-- Depoimento recolhido em 3 linhas com reticências; tocar expande. O texto inteiro continua no HTML para leitores de tela. -->
            <blockquote class="depoimento mt-5 max-w-[60ch] font-titulo text-[1.25rem] leading-[1.5] sm:text-[1.5rem] md:mt-6" data-depoimento>
              <p class="line-clamp-3">“{d.data.texto}”</p>
            </blockquote>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script>
  import { deslizar } from '../lib/sanfona';
  import { semMovimento } from '../lib/placas';

  // Só vira expansível o depoimento que de fato passa de 3 linhas.
  const preparar = () => {
    document.querySelectorAll<HTMLElement>('[data-depoimento]').forEach((bloco) => {
      const texto = bloco.querySelector('p');
      if (!texto || bloco.dataset.aberto !== undefined) return;
      const corta = texto.scrollHeight > texto.clientHeight + 2;
      bloco.toggleAttribute('data-expansivel', corta);
      if (corta) {
        bloco.setAttribute('role', 'button');
        bloco.tabIndex = 0;
        bloco.setAttribute('aria-expanded', 'false');
        bloco.setAttribute('aria-label', 'Ler o depoimento inteiro');
      } else {
        bloco.removeAttribute('role');
        bloco.removeAttribute('tabindex');
        bloco.removeAttribute('aria-expanded');
        bloco.removeAttribute('aria-label');
      }
    });
  };
  const alternar = (bloco: HTMLElement) => {
    if (!bloco.hasAttribute('data-expansivel') || bloco.dataset.deslizando) return;
    const abrir = bloco.dataset.aberto === undefined;
    const aplicar = () => {
      bloco.toggleAttribute('data-aberto', abrir);
      bloco.setAttribute('aria-expanded', String(abrir));
      bloco.setAttribute('aria-label', abrir ? 'Recolher o depoimento' : 'Ler o depoimento inteiro');
    };
    const texto = bloco.querySelector<HTMLElement>('p');
    if (semMovimento || !texto) return aplicar();
    // O texto desliza até a nova altura; ao recolher, as reticências só voltam no fim.
    bloco.dataset.deslizando = '1';
    const terminar = () => delete bloco.dataset.deslizando;
    const antes = texto.offsetHeight;
    if (abrir) {
      aplicar();
      deslizar(texto, antes, texto.offsetHeight, 300, terminar, false);
    } else {
      bloco.removeAttribute('data-aberto');
      const depois = texto.offsetHeight;
      bloco.setAttribute('data-aberto', '');
      deslizar(texto, antes, depois, 200, () => { aplicar(); terminar(); }, false);
    }
  };
  document.addEventListener('click', (e) => {
    const bloco = (e.target as HTMLElement).closest<HTMLElement>('[data-depoimento]');
    if (bloco) alternar(bloco);
  });
  document.addEventListener('keydown', (e) => {
    const bloco = (e.target as HTMLElement).closest?.<HTMLElement>('[data-depoimento]');
    if (bloco && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); alternar(bloco); }
  });
  document.addEventListener('astro:page-load', () => document.fonts.ready.then(preparar));
  let espera: ReturnType<typeof setTimeout> | undefined;
  window.addEventListener('resize', () => { clearTimeout(espera); espera = setTimeout(preparar, 200); });
</script>

<style>
  .depoimento[data-expansivel] { cursor: pointer; }
  .depoimento[data-aberto] p { -webkit-line-clamp: unset; line-clamp: unset; display: block; overflow: visible; }
  @media (hover: hover) {
    .depoimento[data-expansivel]:not([data-aberto]):hover p { color: var(--color-branco); text-decoration: underline; text-decoration-color: rgb(255 255 255 / 0.3); text-underline-offset: 0.25em; }
  }
</style>
