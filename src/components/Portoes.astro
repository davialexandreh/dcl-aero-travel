---
import { caminho } from '../lib/caminho';
import IconeWhatsApp from './IconeWhatsApp.astro';
import { ArrowRight } from '@lucide/astro';
import Placas from './Placas.astro';
import { linkWhatsApp } from '../lib/whatsapp';
import { servicos } from '../data/servicos';

// Resumo curto de cada serviço na home; o resto do conteúdo vem de data/servicos.ts.
const resumos: Record<string, string> = {
  'passagens-com-milhas': 'Passagem mais barata usando milhas, sem você precisar ter milhas. Nacional e internacional, com parcelamento.',
  pacotes: 'Passagem, hotel e passeios num pacote só, montado para o seu jeito de viajar.',
  'aluguel-de-carros': 'Carro reservado para retirar no aeroporto, do popular ao SUV.',
  'mentoria-em-milhas': 'Para quem quer aprender a juntar e usar as próprias milhas, ou prefere que alguém cuide disso.',
};
const portoes = servicos.map((s) => ({
  portao: s.portao, nome: s.nome, href: caminho(`/${s.slug}`), ref: s.ref, texto: resumos[s.slug], mensagem: s.mensagem,
}));
---
<section id="servicos" class="claro bg-branco text-marinho" aria-labelledby="servicos-titulo">
  <div class="mx-auto max-w-[78rem] px-4 py-20 sm:px-6 md:py-28 lg:px-8">
    <h2 id="servicos-titulo" class="max-w-[18ch] text-[2.25rem] sm:text-[3rem] lg:text-[3.5rem]">Para onde você quer ir?</h2>
    <ul class="mt-12 border-t border-linha" role="list">
      {portoes.map((p) => (
        <li class="grid gap-x-8 gap-y-4 border-b border-linha py-8 md:grid-cols-[auto_minmax(0,1fr)_auto] md:items-center">
          <div class="flex items-center gap-5 md:contents">
            <Placas texto={p.portao} class="text-[2rem] sm:text-[2.5rem]" />
            <div class="md:max-w-[56ch]">
              <h3 class="font-painel text-[1.625rem] font-semibold tracking-[0.04em] uppercase sm:text-[1.875rem]">
                <a href={p.href} class="no-underline hover:underline">{p.nome}</a>
              </h3>
              <p class="mt-1 hidden text-tinta-suave md:block">{p.texto}</p>
            </div>
          </div>
          <p class="text-tinta-suave md:hidden">{p.texto}</p>
          <div class="flex flex-wrap items-center gap-3">
            <a class="botao botao-claro min-h-11 px-4 text-[1.0625rem]" href={linkWhatsApp(p.mensagem, p.ref)}>
              <IconeWhatsApp size={18} /> Cotar
            </a>
            <!-- Um só botão preenchido por portão; o "Saiba mais" é link, para o Cotar ter força. -->
            <a class="inline-flex min-h-11 items-center gap-1.5 px-2 font-painel text-[1.0625rem] font-semibold underline decoration-1 underline-offset-[0.22em] hover:decoration-2" href={p.href} aria-label={`Saiba mais sobre ${p.nome}`}>
              Saiba mais <ArrowRight size={18} aria-hidden="true" />
            </a>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
